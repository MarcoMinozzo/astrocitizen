{
  "schema_version": 1,
  "trust_tiers": {
    "T1": {
      "label": "Literatura cientifica primaria",
      "examples": ["papers peer-reviewed", "IAU resolutions"]
    },
    "T2": {
      "label": "Livros / manuais estabelecidos",
      "examples": ["textbooks", "observing handbooks"]
    },
    "T3": {
      "label": "Documentacao da plataforma AstroCitizen",
      "examples": ["docs/", "PO templates", "RN-*", "atlas interno"]
    },
    "T4": {
      "label": "Fontes oficiais de redes (resumo/citacao)",
      "examples": ["AAVSO WebObs docs", "BeSS portal help"]
    },
    "T5": {
      "label": "Notas praticas / abstracts / indices",
      "examples": ["lab notes", "literature index pointers"]
    }
  },
  "topics": [
    "workflows",
    "ux",
    "programs",
