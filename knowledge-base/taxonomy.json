    "analysis",
    "photometry",
    "astrometry",
    "radio",
    "solar",
    "occultation",
    "literature",
    "index",
    "safety"
  ],
  "pipeline_stages": [
    "plan",
    "observe",
    "import",
    "calibrate",
    "analyze",
    "contribute",
    "archive",
    "help"
  ],
  "networks": [
    "aavso",
    "mpc",
    "bess",
    "exoclock",
    "iota",
    "tns",
    "wds",
    "clubes-radio"
  ],
  "langs": ["pt", "es", "en"],
  "filters": {
    "po_id": "PO-* template id when chunk is program-specific",
    "network": "contribution network key",
    "topic": "taxonomy.topics",
    "trust_tier": "T1..T5",
    "lang": "pt|es|en"
  }
}
